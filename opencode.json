{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@tencentdb-agent-memory/memory-tencentdb",
      {
        "gatewayUrl": "http://127.0.0.1:8420",
        "timeoutMs": 5000,
        "capture": {
          "enabled": true
        },
        "recall": {
          "enabled": true,
          "maxResults": 5,
          "maxTotalChars": 6000
        },
        "tools": {
          "enabled": true
        },
        "redaction": {
          "enabled": true
        }
      }
    ]
  ]
}
