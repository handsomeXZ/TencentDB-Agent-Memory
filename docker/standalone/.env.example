# Copy this file to .env.local and fill in real secrets.
# Do not commit .env.local.

# Required for OpenRouter embeddings. Container exits if left empty.
OPENROUTER_API_KEY=

# Required for L1/L2/L3 memory extraction chat/completion calls. Container exits if left empty.
TDAI_LLM_BASE_URL=https://api.openai.com/v1
TDAI_LLM_API_KEY=
TDAI_LLM_MODEL=gpt-4o-mini

# Required for Gateway auth in this standalone image. Container exits if left empty.
TDAI_GATEWAY_API_KEY=

# Required for the Memory Visualizer browser login when running the production container.
TDAI_VIS_API_KEY=

# Optional browser CORS allow-list, comma-separated when set by environment.
# This works because the YAML file does not set server.corsOrigins.
# If unset, the default remains no CORS response headers.
# TDAI_CORS_ORIGINS=http://localhost:3000
